{
  "name": "@reticlehq/electron-smoke",
  "version": "2.13.1",
  "private": true,
  "description": "A real Electron app (Vite + React renderer, contextBridge IPC) to smoke-test Reticle on Electron.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:5174 && electron .\"",
    "dev:packaged": "vite build && cross-env RETICLE_DEMO_FILE=1 electron .",
    "typecheck": "tsc -b"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@reticlehq/browser": "workspace:*",
    "@reticlehq/react": "workspace:*",
    "@reticlehq/vite-plugin": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0",
    "@reticlehq/electron": "workspace:*"
  }
}
