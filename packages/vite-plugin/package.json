{
  "name": "@reticlehq/vite-plugin",
  "version": "2.13.1",
  "description": "Vite plugin for Reticle: dev-only source-map stamping plus auto-injected reticle.connect(). apply:'serve' guarantees it never ships to production.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Reticle contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reticlehq/reticle.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/reticlehq/reticle#readme",
  "bugs": "https://github.com/reticlehq/reticle/issues",
  "keywords": [
    "vite-plugin",
    "reticle",
    "react",
    "devtools"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/build-cjs.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test:unit": "vitest run src --passWithNoTests",
    "test:coverage": "vitest run src --passWithNoTests --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include='src/**/*.ts' --coverage.exclude='src/**/*.test.ts'",
    "prepack": "tsc -b && node scripts/build-cjs.mjs && node ../../scripts/prepare-dist.mjs dist",
    "build:cjs": "node scripts/build-cjs.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@reticlehq/babel-plugin": "workspace:*",
    "@reticlehq/core": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "svelte": "^5.57.0",
    "vite": "^8",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
