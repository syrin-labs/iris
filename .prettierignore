pnpm-lock.yaml
**/dist/**
# electron-vite writes its bundle to `out/`, not `dist/`. The fixture gitignores it, but prettier
# has its own ignore list and scanned the build output — so `format:check` went red on three
# generated files nobody wrote, on a PR whose only crime was adding a fixture that builds.
**/out/**
**/node_modules/**
**/.turbo/**
plan/
coverage/
.agents/
GRAPH_REPORT.md

apps/e2e/
apps/vibe-builder-demo/

# Marketing/benchmark design artifacts — generated cards, compact inline-style
# HTML/CSS rendered to images/video; not held to the code formatter.
assets/

# Benchmark generated outputs (raw measured JSON, logs, rendered charts) — data, not code.
bench/raw/
bench/logs/
bench/artifacts/
# Head-to-head harness outputs: measured result JSON + generated scorecards. Keep byte-identical to
# what bench-all.mjs emits so re-running the benchmark doesn't dirty the tree via the formatter.
bench/pw-vs-reticle/*.json
bench/pw-vs-reticle/*SCORECARD*.md
apps/examples/*/
# Generated by `node apps/e2e/matrix.mjs`. Formatting it makes every regeneration fail
# format:check, which teaches people to skip the gate rather than fix the file.
docs/matrix/MATRIX.md
# Same reason: generated by `node apps/e2e/soak.mjs --record`.
bench/TOOL-PROFILE.md
# Same reason again, one layer down: `next dev` regenerates these inside the Next fixture and its
# formatting is not ours to argue with. They are gitignored, but prettier reads the disk, not git,
# so without this a battery run leaves format:check red on files nobody wrote.
apps/next-smoke/next-env.d.ts
apps/next-smoke/AGENTS.md
apps/next-smoke/CLAUDE.md
